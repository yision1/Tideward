<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>

		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
		<PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
		<PackageReference Include="Polly" Version="8.7.0" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Starward.NativeLib" Version="0.3.1" />
		<PackageReference Include="Vanara.PInvoke.Kernel32" Version="5.0.7" />
		<PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="**\*.proto" />
        <EmbeddedResource Include="GameInstall/KuroPatch.LICENSE" LogicalName="Tideward.RPC.KuroPatch.LICENSE" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Tideward.Core\Tideward.Core.csproj" />
	  <ProjectReference Include="..\Tideward.Setup.Core\Tideward.Setup.Core.csproj" />
	</ItemGroup>

</Project>
