<sf:WindowEx x:Class="Tideward.Features.GameLauncher.GameNoticeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sf="using:Tideward.Frameworks">
    <Grid Loaded="Grid_Loaded">
        <Border Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#60000000" CornerRadius="8">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <ProgressRing x:Name="LoadingRing" Width="60" Height="60" Foreground="{ThemeResource AccentFillColorDefaultBrush}" IsIndeterminate="True" />
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12">
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" MaxWidth="440" />
                <Button Content="关闭" Click="Close_Click" />
            </StackPanel>
          </StackPanel>
        </Border>
        <WebView2 x:Name="webview" DefaultBackgroundColor="Transparent" Visibility="Collapsed">
            <WebView2.Resources>
                <SolidColorBrush x:Key="BrushForThemeBackgroundColor" Color="Transparent" />
            </WebView2.Resources>
        </WebView2>
    </Grid>
</sf:WindowEx>
