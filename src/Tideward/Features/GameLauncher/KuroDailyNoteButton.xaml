<UserControl x:Class="Tideward.Features.GameLauncher.KuroDailyNoteButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sc="using:Tideward.Controls"
             xmlns:local="using:Tideward.Features.GameLauncher">
    <Button Width="40" Height="40" Padding="4" ToolTipService.ToolTip="鸣潮便笺"
            AutomationProperties.Name="鸣潮便笺" Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
        <sc:CachedImage x:Name="NoteIcon" Width="32" Height="32" />
        <Button.Flyout>
            <Flyout x:Name="NoteFlyout" Placement="LeftEdgeAlignedTop" Opened="NoteFlyout_Opened">
                <StackPanel Width="324" Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <FontIcon x:Name="AvatarPlaceholder" FontSize="28" Glyph="&#xE77B;" />
                            <sc:CachedImage x:Name="RoleAvatarImage" Width="40" Height="40" CornerRadius="20" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Name="RoleNameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="RoleInfoText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="2" Width="28" Height="28" Padding="4" VerticalAlignment="Top"
                                Click="RefreshButton_Click" ToolTipService.ToolTip="刷新" AutomationProperties.Name="刷新便笺"
                                Style="{ThemeResource DateTimePickerFlyoutButtonStyle}">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                    </Grid>
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="StatsArea" Visibility="Collapsed" Spacing="14">
                        <ItemsRepeater x:Name="PrimaryStatsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="156" MinColumnSpacing="12" Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:KuroDailyNoteStatView">
                                    <Grid ColumnSpacing="8" ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind Description}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <sc:CachedImage Width="32" Height="32" VerticalAlignment="Center" Source="{x:Bind Icon}" />
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Amount}" FontSize="16" />
                                            <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="{x:Bind Detail}" /><Run Text="{x:Bind RecoveryDayHint}" Foreground="{ThemeResource SystemFillColorCautionBrush}" /></TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater x:Name="StatsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MaximumRowsOrColumns="3" MinItemWidth="92" MinColumnSpacing="12" MinRowSpacing="12" Orientation="Horizontal" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:KuroDailyNoteStatView">
                                    <StackPanel Spacing="2" ToolTipService.ToolTip="{x:Bind Description}" AutomationProperties.Name="{x:Bind Description}">
                                        <TextBlock Text="{x:Bind Label}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Amount}" FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource WhiteSpaceStringToVisibilityConverter}}" />
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
