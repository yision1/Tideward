<sf:WindowEx x:Class="Tideward.Features.GameLauncher.KuroLoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sf="using:Tideward.Frameworks">
    <Grid Loaded="Grid_Loaded" RowSpacing="8" Padding="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="请完成库街区的短信登录和人机验证。Tideward 使用 App 登录凭据读取便笺和战绩，连接信息只在本机加密保存。" TextWrapping="Wrap" />
        <WebView2 x:Name="webview" Grid.Row="1" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" MaxWidth="550" TextWrapping="Wrap" />
            <Button Content="重新加载" Click="Reload_Click" />
            <Button Content="取消" Click="Cancel_Click" />
        </StackPanel>
    </Grid>
</sf:WindowEx>
