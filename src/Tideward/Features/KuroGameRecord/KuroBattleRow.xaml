<UserControl x:Class="Tideward.Features.KuroGameRecord.KuroBattleRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Starward node layout, using portrait-only Kuro battle avatars. -->
    <Grid x:Name="ContentGrid" Padding="20,8,20,12" RowSpacing="8" SizeChanged="ContentGrid_SizeChanged">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock x:Name="DetailText" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel x:Name="Marks" Orientation="Horizontal" Spacing="2" Visibility="Collapsed" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="12">
            <StackPanel x:Name="Portraits" Orientation="Horizontal" Spacing="12" />
            <StackPanel x:Name="Buffs" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
